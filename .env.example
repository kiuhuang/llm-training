# =============================================================================
# llm-training — environment configuration
#
# Copy to .env with `make init`, then edit. .env is git-ignored.
# Precedence: shell environment  >  .env  >  built-in script defaults.
# $VAR / ${VAR} are expanded from already-set variables — define SCRATCH
# BEFORE the entries that derive from it.
# =============================================================================

# ---- HPC storage -----------------------------------------------------------
# ADAPT: point SCRATCH at the node's 30.7 TB local NVMe (check `df -h`;
# on many DGX clusters it is /raid or /scratch). The default below works
# everywhere but lands on $HOME — fine for smoke tests, not for checkpoints.
SCRATCH=$HOME/llm-scratch
HF_HOME=$SCRATCH/hf_cache                 # HF model/dataset cache (~30 GB total)
APPTAINER_CACHEDIR=$SCRATCH/apptainer_cache

# ---- SLURM (consumed by `make submit-*`; ADAPT to `sinfo`) ------------------
SLURM_PARTITION=gpu
SLURM_GRES=gpu:8                          # or gpu:h800:8 if typed GRES exist
SLURM_TIME=24:00:00
SLURM_CPUS=32
SLURM_MEM=400G
# SLURM_ACCOUNT=myaccount                  # uncomment if your site requires it

# ---- Apptainer container ----------------------------------------------------
# Base image for the build; swap for any CUDA 12.x/13.x PyTorch image whose
# driver requirement your node satisfies (model choice needs NO new container).
# NOTE: NGC torch builds use pre-release version strings (e.g. 2.7.0a0). Use a
# tag whose torch is >= 2.6.0a0 — older bases (24.09 = 2.5.0a0) fail recent
# transformers' "PyTorch >= 2.5" version gate. 25.03 = torch 2.7.0a0, CUDA 12.8.1.
CONTAINER_BASE=nvcr.io/nvidia/pytorch:25.03-py3   # baked in by `make container-build`
# Persistent extracted image (preferred): built once by `make container-build`,
# runs start in seconds — no per-run SIF conversion (host has no squashfuse).
APPTAINER_SANDBOX=$SCRATCH/apptainer_sandbox
APPTAINER_IMAGE=images/qwen35.sif                 # optional SIF (BUILD_SIF=1) — fallback if sandbox absent
BUILD_SIF=0                                       # 1 = also pack a SIF during container-build
APPTAINER_TMPDIR=$SCRATCH/apptainer_tmp           # only used when running from a SIF
# LIBCUDA_CANDIDATES=/usr/lib/x86_64-linux-gnu/libcuda.so.1   # override if the driver lib
#                                                              lives in a non-standard path

# ---- run mode ----------------------------------------------------------------
# local = run directly on the node you are SSH-ed into (no SLURM) — works on
#         any node allocated/drained to you, full-GPU without the scheduler
# slurm = submit via sbatch (make submit-*); SLURM_* values below are used
RUN_MODE=local

# ---- training ---------------------------------------------------------------
GPUS=8
DEEPSPEED_ZERO=2                          # 2 or 3 (scripts/train_full.sh)

# ---- evaluation -------------------------------------------------------------
EVAL_MODEL=Qwen/Qwen3.5-4B-Base
EVAL_ADAPTER=outputs/lora_v1/final        # empty -> prefer EVAL_MERGED
EVAL_MERGED=outputs/merged_v1
EVAL_PROMPTS=outputs/eval/eval_prompts.jsonl
EVAL_DIR=outputs/eval
EVAL_MAX_NEW_TOKENS=512
EVAL_BATCH_SIZE=8

# ---- data prep (worked example; swap for any HF dataset) ---------------------
# prepare_data.py expects {system, user, assistant} string columns —
# other schemas need a small edit in its normalize() (docs/02)
DATASET_ID=Josephgflowers/Finance-Instruct-500k
# `make data` samples DATA_TRAIN_ROWS rows (fast iteration default).
# `make data-full` IGNORES these and uses the FULL ~518k dataset
# (--no-streaming + true global shuffle). CLI flags override all of these.
DATA_TRAIN_ROWS=30000
DATA_VAL_ROWS=500
DATA_TEST_ROWS=500

# ---- python environment (setup/setup_env.sh) --------------------------------
VENV_DIR=$HOME/.venvs/llm-train
TORCH_INDEX=https://download.pytorch.org/whl/cu124
FLASH_ATTN=0                              # 1 = compile flash-attn (bare-metal path only)

# ---- optional HF token (gated models only; Qwen3.5 + dataset are open) ------
# HF_TOKEN=hf_xxxxxxxxxxxxxxxx
